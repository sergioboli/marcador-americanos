<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050505"
    android:orientation="vertical"
    android:keepScreenOn="true">

    <!-- Pantalla de inicio con el botón de Empezar -->
    <LinearLayout
        android:id="@+id/layoutStart"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Americano Padel (17 min)"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center" />

        <Button
            android:id="@+id/btnStart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="#4CAF50"
            android:text="EMPEZAR"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Contenido principal del marcador (Visible al pulsar Empezar) -->
    <LinearLayout
        android:id="@+id/layoutWearMainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Barra superior para el Temporizador (rotado 90 grados) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#111111"
            android:gravity="center"
            android:paddingVertical="4dp">

            <TextView
                android:id="@+id/tvTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="17:00"
                android:textColor="#FFCA28"
                android:textSize="20sp"
                android:textStyle="bold"
                android:rotation="90" />
        </LinearLayout>

        <!-- Mitad Superior: Equipo A -->
        <FrameLayout
            android:id="@+id/layoutTeamA"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#154CAF50"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <TextView
                    android:id="@+id/tvGamesA"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="J: 0"
                    android:textColor="#81C784"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:rotation="90"
                    android:layout_marginEnd="24dp" />

                <TextView
                    android:id="@+id/tvScoreA"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#81C784"
                    android:textSize="90sp"
                    android:textStyle="bold"
                    android:rotation="90"
                    android:includeFontPadding="false" />
            </LinearLayout>
        </FrameLayout>

        <!-- Línea divisoria -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#333333" />

        <!-- Mitad Inferior: Equipo B -->
        <FrameLayout
            android:id="@+id/layoutTeamB"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#152196F3"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <TextView
                    android:id="@+id/tvGamesB"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="J: 0"
                    android:textColor="#64B5F6"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:rotation="90"
                    android:layout_marginEnd="24dp" />

                <TextView
                    android:id="@+id/tvScoreB"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#64B5F6"
                    android:textSize="90sp"
                    android:textStyle="bold"
                    android:rotation="90"
                    android:includeFontPadding="false" />
            </LinearLayout>
        </FrameLayout>

    </LinearLayout>

</LinearLayout>
